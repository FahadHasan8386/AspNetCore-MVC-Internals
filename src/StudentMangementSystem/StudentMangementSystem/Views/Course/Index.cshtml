@model List<StudentMangementSystem.Models.Course>

<div class="container mt-4">
	<h2>Course Management</h2>

	<a></a>

	<table class="table table-bordered table-striped">
		<thead>
			<tr>
				<th>Course Name</th>
				<th>Course Code</th>
				<th>Credit</th>
				<th>Description</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var course in Model)
			{
				<tr>
					<td>@course.CourseName</td>
					<td>@course.CourseCode</td>
					<td>@course.Credit</td>
					<td>@course.Description</td>
					<td>
						<a asp-action="EditCourse" asp-route-id="@course.Id" class="btn btn-primary btn-sm">Edit</a>
						<a asp-action="DeleteCourse" asp-route-id="@course.Id"
						   class="btn btn-danger btn-sm"  onclick="return confirm('Delete this course?')">
							Delete
						</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>