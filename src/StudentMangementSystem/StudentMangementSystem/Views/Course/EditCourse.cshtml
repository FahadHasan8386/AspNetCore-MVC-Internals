
@model StudentMangementSystem.Models.Course

<div class="container mt-4">
    <h2>Edit Course</h2>

    <form asp-action="EditCourse" method="post">
        <input asp-for="Id" type="hidden" />

        <div class="mb-3">
            <label asp-for="CourseName" class="form-label"></label>
            <input asp-for="CourseName" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="CourseCode" class="form-label"></label>
            <input asp-for="CourseCode" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Credit" class="form-label"></label>
            <input asp-for="Credit" type="number" min="1" class="form-control"required />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">
            Update Course
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
