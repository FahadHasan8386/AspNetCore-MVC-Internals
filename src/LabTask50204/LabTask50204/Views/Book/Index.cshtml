@model IEnumerable<LabTask50204.Models.Book>

@{
    ViewData["Title"] = "Book List";
}

<div class="container mt-4">
    <h2 class="mb-3">Library Books</h2>

    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>BookId</th>
                <th>Title</th>
                <th>Author</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.BookId</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                </tr>
            }
        </tbody>
    </table>
</div>